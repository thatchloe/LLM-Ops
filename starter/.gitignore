# Local secrets (.env.example is tracked as the template)
.env
.env.local

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/

# Local on-disk data stores written by the starter at runtime
data/chroma/
data/phoenix/

# Runtime inbox: keep the directory (via .gitkeep) but ignore fixtures
# dropped in during dry runs. data/inbox/failed/ and data/cost_log.jsonl
# stay tracked because they are required submission evidence.
data/inbox/*.json

# Operator runtime artifacts from `make harvest-evidence`
WRITEUP-draft.md
WRITEUP-evidence/

# OS-level
.DS_Store

# Local Claude state
.claude/

# Raw server output from scripts/capture_live_evidence.sh
evidence/live/server.log
